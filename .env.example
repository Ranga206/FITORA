# ==============================================================================
# FITORA ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env before starting local development
# Note: Do NOT commit secrets or real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION GENERAL
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=Fitora
PORT=8080

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ------------------------------------------------------------------------------
# BACKEND API CONFIGURATION
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# TODO: Finalize database provider choice (PostgreSQL / MySQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitora_db
DB_USER=fitora_user
DB_PASSWORD=your_secure_password_here
# JDBC Connection URL Example:
# DATABASE_URL=jdbc:postgresql://localhost:5432/fitora_db

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# TODO: Finalize secret keys and token expiration parameters
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_length_here
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# FUTURE INTEGRATIONS (PLACEHOLDERS)
# ------------------------------------------------------------------------------
# TODO: Add third-party nutrition/food API keys if needed
# TODO: Add cloud storage / asset upload keys if needed
